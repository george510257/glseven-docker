# Copy this file to .env and adjust values for your environment.
# .env is gitignored and will not be committed.

# Base directory for all Docker volume mounts.
# Example: DOCKER_VOLUME=/docker/glseven
DOCKER_VOLUME=/docker/glseven

# Redis password shared by redis (--requirepass) and moontv (REDIS_URL).
REDIS_PASSWORD=glseven_redis_2024
