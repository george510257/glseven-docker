# Copy this file to .env and adjust values for your environment.
# .env is gitignored and will not be committed.

# Optional base directory for all Docker volume mounts.
# startup.sh defaults to /docker/glseven on Linux and $HOME/docker/glseven on macOS.
# Set this only when the data directory must be customized.
# DOCKER_VOLUME=/docker/glseven
# macOS example: DOCKER_VOLUME=$HOME/docker/glseven

# Redis password shared by redis (--requirepass) and moontv (REDIS_URL).
# Avoid special characters (/ ? # % @ ' and spaces): REDIS_URL is not percent-encoded.
REDIS_PASSWORD=glseven_redis_2024
