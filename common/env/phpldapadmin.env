LDAP_HOST=openldap
# 登录模式：默认 uid——USER ID 填 admin 即可。
# 依赖 openldap/bootstrap/admin-entry.ldif 给 cn=admin 条目加的 uid=admin 属性（新装环境导入后生效）。
# osixia 全新目录默认无带 uid 的 posixAccount 用户，未导入该 ldif 时 uid 模式必登录失败。
# （若需完整 DN 直接登录，改回 dn：LDAP_LOGIN_ATTR=dn）
# PLA 服务连接账号：osixia 默认 ACL 拒绝匿名读取，不配则登录 bind 成功后读条目报
# "Authentication succeeded, but the DN doesnt exist"（errNo 32 被误判为 DN 不存在）。
# WARNING: 生产部署前请修改此凭据（与 openldap.env 的 LDAP_ADMIN_PASSWORD 保持一致）。
LDAP_USERNAME=cn=admin,dc=glseven,dc=com
LDAP_PASSWORD=admin
# 连接 base_dn：上游镜像 config/ldap.php 遗漏该键（挂载修正版已补），此处同时供 pla.base_dns 使用；
# 缺失时 DN 登录 find/fetch 的查询 base 为空 → errNo 32 → 登录后置检查误报 "DN doesnt exist"。
LDAP_BASE_DN=dc=glseven,dc=com
# WARNING: 生产部署前请修改此凭据。
APP_KEY=base64:JuwqTpSGIF7MzSy8IZTR1mElOXV4tSGZfyQiX44Rb88=
APP_TIMEZONE=Asia/Shanghai
